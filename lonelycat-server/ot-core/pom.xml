<?xml version="1.0" encoding="UTF-8"?>
<!--
  ot-core：纯 Java 的操作转换（OT）算法库
  只包含 TextOperation 数据结构和 apply / compose / transform 三个核心算法。
  不依赖 Spring，方便单独测试，也方便以后被其他服务复用。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lonelycat</groupId>
        <artifactId>lonelycat-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ot-core</artifactId>
    <name>ot-core</name>

    <dependencies>
        <!-- 只在测试里用 Jackson 读取共享的测试向量 JSON，主代码零依赖 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
